<div class="u-window-box-medium" style="max-width: 40rem">
  <form method="post" action="">
    <input type="hidden" name="{{ csrfParam }}" value="{{ csrfToken }}">

    <div class="mb-3">
      <label class="form-label" for="menu-systitle">{{ t('crelish', 'Title') }}</label>
      <input type="text" id="menu-systitle" name="Menu[systitle]" value="{{ menu.systitle }}" maxlength="128" required
             class="form-control{% if menu.hasErrors('systitle') %} is-invalid{% endif %}">
      <div class="invalid-feedback">{{ menu.getFirstError('systitle') }}</div>
    </div>

    <div class="mb-3">
      <label class="form-label" for="menu-key">{{ t('crelish', 'Key') }}</label>
      <input type="text" id="menu-key" name="Menu[key]" value="{{ menu.key }}" maxlength="64" pattern="[a-z0-9_\-]+"
             {% if not menu.isNewRecord %}readonly{% else %}required{% endif %}
             class="form-control{% if menu.hasErrors('key') %} is-invalid{% endif %}">
      <div class="form-text">{{ t('crelish', 'Used by the theme: chelper.menu(\'key\'). Lowercase letters, digits, - and _. Cannot be changed later.') }}</div>
      <div class="invalid-feedback">{{ menu.getFirstError('key') }}</div>
    </div>

    <div class="mb-3">
      <label class="form-label" for="menu-depth">{{ t('crelish', 'Maximum depth') }}</label>
      <select id="menu-depth" name="Menu[max_depth]" class="form-select">
        {% for depth in 1..5 %}
          <option value="{{ depth }}"{% if menu.max_depth == depth %} selected{% endif %}>{{ depth }}</option>
        {% endfor %}
      </select>
    </div>

    <div class="mb-3">
      <label class="form-label" for="menu-state">{{ t('crelish', 'Status') }}</label>
      <select id="menu-state" name="Menu[state]" class="form-select">
        <option value="2"{% if menu.state == 2 %} selected{% endif %}>{{ t('crelish', 'Online') }}</option>
        <option value="0"{% if menu.state == 0 %} selected{% endif %}>{{ t('crelish', 'Offline') }}</option>
      </select>
    </div>

    <button type="submit" class="c-button c-button--brand">{{ t('crelish', 'Save') }}</button>
  </form>

  {% if not menu.isNewRecord %}
    <form method="post" action="{{ url('/crelish/menu/delete', {'uuid': menu.uuid}) }}" class="mt-4"
          onsubmit="return confirm('{{ t('crelish', 'Delete this menu and all its items?')|e('js') }}')">
      <input type="hidden" name="{{ csrfParam }}" value="{{ csrfToken }}">
      <button type="submit" class="c-button c-button--error">{{ t('crelish', 'Delete menu') }}</button>
    </form>
  {% endif %}
</div>
